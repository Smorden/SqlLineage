    <insert id="insertTblList" parameterType="java.lang.String">
        <foreach item="name" collection="tblSet" separator="            ">
            MERGE (n_${name}:Tbl {name: #{name}})
            ON CREATE SET n_${name}.name = #{name}
            ON MATCH SET n_${name}.name = #{name}
        </foreach>

    </insert>


    <insert id="insertTblRelationShipList" parameterType="com.siheng.metadataplatform.pojo.TblRelationShip">
        MATCH
        <foreach item="name" collection="allTbls" separator="," close="  ">
             (n_${name}:Tbl {name:#{name}})
        </foreach>
        <foreach item="name" collection="sourceTbls" close="  ">
         MERGE (n_${name})-[:RELATIONSHIP_TYPE]->(n_${targetTbl})
        </foreach>                                                                       
    </insert>


    <delete id="deleteTblAndAllTblRelationShipList" parameterType="java.lang.String">
        MATCH (n:Tbl {name: #{tblName}})
        DETACH DELETE n
    </delete>

